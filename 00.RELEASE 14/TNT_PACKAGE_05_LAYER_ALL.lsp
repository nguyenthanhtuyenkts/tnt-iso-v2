    (princ)
  )
  (setvar "CMDECHO" 0)
  (setq ss (ssget "_I"))
  (if (not ss)
    (setq ss (ssget))
  )
  (if ss
    (progn
      (command-s "_.CHANGE" ss "" "_Properties" "_LAyer" "0" "")
      (princ (strcat "\n[TNT] N0: Da chuyen " (itoa (sslength ss)) " doi tuong sang layer 0."))
    )
    (princ "\n[TNT] N0: Khong co doi tuong nao duoc chon.")
