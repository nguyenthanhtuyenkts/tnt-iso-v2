                   *TNT.LAYER.SKIP-LTYPE-SYNC-NAMES*
                   NIL))
  (SETQ *TNT.LAYER.SKIP-LTYPE-SYNC-NAMES*
        '("....21_TNT_N_LEADER" "....08_TNT_A_DETAIL"))
