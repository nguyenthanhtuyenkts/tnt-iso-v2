    (PRINC (STRCAT "\n[TNT] ERROR: TNT_LAYER: " (VL-CATCH-ALL-ERROR-MESSAGE LERR)))
    (PRINC "\n[TNT] DONE: TNT_LAYER.")
  )
  (PRINC))
