        nil
        (progn
          (setq data (TNT:MEPB:STRIP-DXF-COLOR-OVERRIDES (entget ent)))
          (if (assoc 62 data)
            (setq data (subst (cons 62 TNT:MEPB:COLOR-BYLAYER) (assoc 62 data) data))
            (setq data (append data (list (cons 62 TNT:MEPB:COLOR-BYLAYER))))
          )
          (not (null (entmod data)))
        )
