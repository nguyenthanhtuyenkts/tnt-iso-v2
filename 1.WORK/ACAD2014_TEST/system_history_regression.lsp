;;; Disposable drawing only; tests the actual SYSTEM/CREATE runtime.
(vl-load-com)
(setq hist-test-root "D:/0.PC TUYEN/0.TNT ISO/00.TNT ISO 2026/")
(setq hist-test-out (open (strcat hist-test-root "1.WORK/ACAD2014_TEST/system_history_result.txt") "w"))
(defun *error* (msg)
  (write-line (strcat "ERROR: " msg) hist-test-out)
  (close hist-test-out)
  (princ msg))
(load (strcat hist-test-root "00.RELEASE 14/TNT_PACKAGE_00_SYSTEM_ALL.lsp"))
(load (strcat hist-test-root "00.RELEASE 14/TNT_PACKAGE_01_CREATE_ALL.lsp"))
(defun TNT:SYS:LOG (msg /) (write-line (strcat "DEBUG: " msg) hist-test-out) (princ msg))
(defun hist-check (label flag)
  (write-line (strcat label ": " (if flag "PASS" "FAIL")) hist-test-out))
(defun TNT:LAYER:HISTORY:MAP (/)
  '(("TNT_H_OLD1" "TNT_H_NEW1") ("TNT_H_OLD2" "TNT_H_NEW2") ("TNT_H_EARLIER2" "TNT_H_NEW2")))
(defun TNT:LAYER:HISTORY:RETIRED (/) '("TNT_H_RETIRED"))
(defun TNT:LAYER:STD-TABLE (/)
  '(("TNT_H_NEW1" "P" "3" "CONTINUOUS" "0.3" "0" "Rename test")
    ("TNT_H_NEW2" "P" "4" "CONTINUOUS" "0" "0" "Merge test")))
(setq hd (vla-get-ActiveDocument (vlax-get-acad-object)) hl (vla-get-Layers hd) hm (vla-get-ModelSpace hd))
(foreach name '("TNT_H_OLD1" "TNT_H_OLD2" "TNT_H_NEW2" "TNT_H_RETIRED") (vla-Add hl name))
(setq preserved-handle (vla-get-Handle (vla-Item hl "TNT_H_OLD1")))
(setq rename-line (vla-AddLine hm (vlax-3d-point '(0 0 0)) (vlax-3d-point '(10 0 0))))
(vla-put-Layer rename-line "TNT_H_OLD1")
(setq merge-line (vla-AddLine hm (vlax-3d-point '(0 1 0)) (vlax-3d-point '(10 1 0))))
(vla-put-Layer merge-line "TNT_H_OLD2")
(setq paper-line (vla-AddLine (vla-get-PaperSpace hd) (vlax-3d-point '(0 2 0)) (vlax-3d-point '(10 2 0))))
(vla-put-Layer paper-line "TNT_H_OLD2")
(setq hb (vla-Add (vla-get-Blocks hd) (vlax-3d-point '(0 0 0)) "TNT_H_BLOCK"))
(setq block-line (vla-AddLine hb (vlax-3d-point '(0 0 0)) (vlax-3d-point '(5 0 0))))
(vla-put-Layer block-line "TNT_H_OLD2")
(setq ha (vla-AddAttribute hb 2 0 "Prompt" (vlax-3d-point '(0 1 0)) "TAG" "VALUE"))
(vla-put-Layer ha "TNT_H_OLD2")
(setq href (vla-InsertBlock hm (vlax-3d-point '(20 0 0)) "TNT_H_BLOCK" 1 1 1 0))
(setq hatt (car (vlax-invoke href 'GetAttributes)))
(vla-put-Layer hatt "TNT_H_OLD2")
(setvar "CLAYER" "TNT_H_OLD2")
(vla-put-Lock (vla-Item hl "TNT_H_OLD2") :vlax-true)
(vla-put-Lock (vla-Item hl "TNT_H_NEW2") :vlax-true)
(vla-put-Freeze (vla-Item hl "TNT_H_NEW2") :vlax-true)
(vla-put-LayerOn (vla-Item hl "TNT_H_NEW2") :vlax-false)
(TNT_LAYER_CREATE)
(hist-check "RENAME_PRESERVES_LAYER_HANDLE" (= preserved-handle (vla-get-Handle (vla-Item hl "TNT_H_NEW1"))))
(hist-check "RENAMED_ENTITY_LINK" (= "TNT_H_NEW1" (vla-get-Layer rename-line)))
(hist-check "MERGE_MODEL" (= "TNT_H_NEW2" (vla-get-Layer merge-line)))
(hist-check "MERGE_PAPER" (= "TNT_H_NEW2" (vla-get-Layer paper-line)))
(hist-check "MERGE_BLOCK_DEFINITION" (= "TNT_H_NEW2" (vla-get-Layer block-line)))
(hist-check "MERGE_ATTRIBUTE_REFERENCE" (= "TNT_H_NEW2" (vla-get-Layer hatt)))
(hist-check "CURRENT_LAYER_UPDATED" (= "TNT_H_NEW2" (getvar "CLAYER")))
(hist-check "FROZEN_OFF_TARGET_HANDLED" (and (= :vlax-false (vla-get-Freeze (vla-Item hl "TNT_H_NEW2"))) (= :vlax-true (vla-get-LayerOn (vla-Item hl "TNT_H_NEW2")))))
(hist-check "OLD_LAYER_REMOVED" (null (tblsearch "LAYER" "TNT_H_OLD2")))
(hist-check "STANDARD_COLOR_APPLIED" (= 3 (vla-get-Color (vla-Item hl "TNT_H_NEW1"))))
(hist-check "RETIRED_WITHOUT_TARGET_KEPT" (tblsearch "LAYER" "TNT_H_RETIRED"))
(hist-check "DRAWING_AUDIT_RECORDED" (dictsearch (namedobjdict) "TNT_LAYER_HISTORY"))
(command-s "_.UNDO" "1")
(hist-check "UNDO_RESTORES_OLD_NAME" (and (tblsearch "LAYER" "TNT_H_OLD1") (null (tblsearch "LAYER" "TNT_H_NEW1"))))
(TNT_LAYER_CREATE)
;;; Importing an earlier alias after a completed update must be detected again.
(vla-Add hl "TNT_H_EARLIER2")
(setq imported (vla-AddLine hm (vlax-3d-point '(0 8 0)) (vlax-3d-point '(10 8 0))))
(vla-put-Layer imported "TNT_H_EARLIER2")
(TNT_LAYER_CREATE)
(hist-check "IMPORTED_OLD_ALIAS_RESCANNED" (= "TNT_H_NEW2" (vla-get-Layer imported)))
(TNT_LAYER_CREATE)
(hist-check "REPEATED_APPLY_SAFE" (and (tblsearch "LAYER" "TNT_H_NEW1") (null (tblsearch "LAYER" "TNT_H_OLD1"))))
(write-line "ALL_SYSTEM_HISTORY_COMPLETE" hist-test-out)
(close hist-test-out)
(princ)
