(vl-load-com)
(load "D:/0.PC TUYEN/0.TNT ISO/00.TNT ISO 2026/00.RELEASE 14/TNT_DANH_MUC_BAN_VE.lsp")
(setq log (open "D:/0.PC TUYEN/0.TNT ISO/00.TNT ISO 2026/1.WORK/ACAD2014_TEST/dmbv_result.txt" "w"))
(defun check (name value) (write-line (strcat name ": " (if value "PASS" "FAIL")) log) (princ (strcat "\n" name ": " (if value "PASS" "FAIL")) ))
(write-line (strcat "ACADVER=" (getvar "ACADVER")) log)
(check "hit-forward" (equal 0.25 (tnt:dmbv-hit '(0 0 0) '(40 0 0) '(10 -5 0) '(20 5 0)) 1e-8))
(check "hit-reverse" (equal 0.5 (tnt:dmbv-hit '(40 0 0) '(0 0 0) '(10 -5 0) '(20 5 0)) 1e-8))
(check "miss" (null (tnt:dmbv-hit '(0 10 0) '(40 10 0) '(10 -5 0) '(20 5 0))))
(check "zero-stt" (= "001" (tnt:dmbv-value "STTBV_DOC" '(("STTBV_DOC" . "001")))))
(check "title-paragraph" (= "MAT BANG DINH VI THUA DAT" (tnt:dmbv-title-flat "MAT BANG \\PDINH VI THUA DAT")))
(check "title-repeated-breaks" (= "A B C" (tnt:dmbv-title-flat " A\\P \\PB\r\nC ")))
(check "title-literal-backslash" (= "A\\\\PB" (tnt:dmbv-title-flat "A\\\\PB")))
(check "title-trailing-backslash" (= "A B\\" (tnt:dmbv-title-flat "A\\PB\\")))
(check "mapping-normalize" (equal '("STTBV_DOC" "SHEET_NO") (tnt:dmbv-tags " sttbv_doc, sheet_no, ")))
(check "mapping-alternate-template" (= "002" (cdr (tnt:dmbv-match '("STTBV_DOC" "SHEET_NO") '(("SHEET_NO" . "002"))))))
(check "mapping-empty-fallback" (= "003" (cdr (tnt:dmbv-match '("STTBV_DOC" "SHEET_NO") '(("STTBV_DOC" . "") ("SHEET_NO" . "003"))))))
(check "mapping-priority" (= "001" (cdr (tnt:dmbv-match '("STTBV_DOC" "SHEET_NO") '(("STTBV_DOC" . "001") ("SHEET_NO" . "003"))))))
(check "mapping-missing" (null (tnt:dmbv-match '("MISSING") '(("OTHER" . "X")))))
(check "mapping-empty-present" (equal '("EMPTY" . "") (tnt:dmbv-match '("EMPTY") '(("EMPTY" . "")))))
(setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) ms (vla-get-ModelSpace doc))
(foreach name '(".TNT_A_TXT_1_MAIN" ".TNT_A_TXT_2_SUB" ".TNT_A_TXT_3_NOTE")
  (if (not (tblsearch "STYLE" name)) (vla-Add (vla-get-TextStyles doc) name)))
(setq made nil)
(setq result (vl-catch-all-apply 'tnt:dmbv-table (list ms '(0 0 0) '((label "CUM 1") (drawing "001" "KT-01" "MAT BANG")) 8.0)))
(if (vl-catch-all-error-p result)
 (write-line (strcat "TABLE ERROR: " (vl-catch-all-error-message result)) log)
 (progn
  (check "table-rows" (= 4 (vla-get-Rows result)))
  (check "grid-layer" (= "....03_TNT_A_THIN" (vla-get-Layer result)))
  (setq count 0 main 0 sub 0 note 0)
  (foreach obj made
    (if (= "AcDbMText" (vla-get-ObjectName obj))
      (progn
        (setq count (1+ count))
        (check "text-layer" (= "....20_TNT_N_TEXT" (vla-get-Layer obj)))
        (cond
          ((= ".TNT_A_TXT_1_MAIN" (vla-get-StyleName obj)) (setq main (1+ main)))
          ((= ".TNT_A_TXT_2_SUB" (vla-get-StyleName obj)) (setq sub (1+ sub)))
          ((= ".TNT_A_TXT_3_NOTE" (vla-get-StyleName obj)) (setq note (1+ note)))))))
  (check "text-count-and-styles" (and (= 8 count) (= 1 main) (= 4 sub) (= 3 note)))
  (check "table-cells-empty" (= "" (vla-GetText result 3 0)))) )
(close log)
(princ)
