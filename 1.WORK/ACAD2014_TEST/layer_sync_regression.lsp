;;; Run only in a disposable drawing; no drawing is saved.
(vl-load-com)
(setq test-root "D:/0.PC TUYEN/0.TNT ISO/00.TNT ISO 2026/")
(load (strcat test-root "00.RELEASE 14/TNT_SUPPORT_LISP/TNT_LAYER_SYNC_ALL.lsp"))
(setq test-out (open (strcat test-root "1.WORK/ACAD2014_TEST/layer_sync_regression_result.txt") "w"))
(defun *error* (msg)
  (write-line (strcat "ERROR: " msg) test-out)
  (close test-out)
  (princ msg))
(defun test-check (label flag)
  (write-line (strcat label ": " (if flag "PASS" "FAIL")) test-out))
(setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
(setq old "...26_TNT_WATER-DRAIN-TOILET" new "....41_TNT_P_DRAIN-TOILET")
(test-check "TOILET_MAPPING" (= new (TNT:LAYER-SYNC:TARGET-LAYER old)))
(TNT:LAYER-SYNC:UNLOCK old)
(TNT:LAYER-SYNC:UNLOCK new)
(setq model-line (vla-AddLine (vla-get-ModelSpace doc) (vlax-3d-point '(0 0 0)) (vlax-3d-point '(10 0 0))))
(setq paper-line (vla-AddLine (vla-get-PaperSpace doc) (vlax-3d-point '(0 0 0)) (vlax-3d-point '(10 0 0))))
(vla-put-Layer model-line old)
(vla-put-Layer paper-line old)
(setvar "TILEMODE" 1)
;;; Reproduce the original implementation: paper entity is ignored by CHPROP.
(setq ss (ssget "_X" (list (cons 8 (TNT:LAYER-SYNC:EXACT-FILTER old)))))
(command-s "_.CHPROP" ss "" "_LA" new "")
(test-check "OLD_CODE_SKIPS_PAPER" (= old (vla-get-Layer paper-line)))
(vla-put-Layer model-line old)
(vla-put-Lock (TNT:LAYER-SYNC:LAYER-OBJ old) :vlax-true)
(setq moved (TNT:LAYER-SYNC:MOVE old new))
(test-check "MODEL_MOVED" (= new (vla-get-Layer model-line)))
(test-check "PAPER_MOVED" (= new (vla-get-Layer paper-line)))
(test-check "COUNT_IS_ACTUAL" (>= moved 2))
;;; A dot in a layer name must match literally, not another punctuation mark.
(TNT:LAYER-SYNC:UNLOCK "TNT.TEST")
(TNT:LAYER-SYNC:UNLOCK "TNT-TEST")
(setq a (vla-AddLine (vla-get-ModelSpace doc) (vlax-3d-point '(0 2 0)) (vlax-3d-point '(10 2 0))))
(setq b (vla-AddLine (vla-get-ModelSpace doc) (vlax-3d-point '(0 3 0)) (vlax-3d-point '(10 3 0))))
(vla-put-Layer a "TNT.TEST")
(vla-put-Layer b "TNT-TEST")
(TNT:LAYER-SYNC:MOVE "TNT.TEST" new)
(test-check "EXACT_NAME_MOVED" (= new (vla-get-Layer a)))
(test-check "SIMILAR_NAME_UNCHANGED" (= "TNT-TEST" (vla-get-Layer b)))
(setq blk (vla-Add (vla-get-Blocks doc) (vlax-3d-point '(0 0 0)) "TNT_SYNC_REGRESSION"))
(setq nested (vla-AddLine blk (vlax-3d-point '(0 0 0)) (vlax-3d-point '(5 0 0))))
(vla-put-Layer nested old)
(TNT:LAYER-SYNC:MOVE-BLOCK-DEFS old new)
(test-check "BLOCK_DEFINITION_MOVED" (= new (vla-get-Layer nested)))
(TNT:LAYER-SYNC:UNLOCK "...27_TNT_WATER-DRAIN-RAIN")
(vla-put-Layer model-line "...27_TNT_WATER-DRAIN-RAIN")
(vla-put-Layer paper-line old)
(c:TNT_LAYER_SYNC_ALL)
(test-check "ALL_COMMAND_OTHER_MAPPING" (= "....42_TNT_P_DRAIN-RAIN" (vla-get-Layer model-line)))
(test-check "ALL_COMMAND_TOILET_PAPER" (= new (vla-get-Layer paper-line)))
(test-check "ALL_RUN_COMPLETE" T)
(close test-out)
(princ)
